@inherits LayoutComponentBase
@using HotsPatchNotes.Web.Components

<div class="page">
    <header class="top-header">
        <div class="container">
            <a href="/" class="brand">
                <span class="brand-text">NEXUS CODEX</span>
            </a>
            <nav class="nav-links">
                <a href="/" class="nav-link">Heroes</a>
                <a href="/battlegrounds" class="nav-link">Battlegrounds</a>
                <a href="/patches" class="nav-link">Patch Notes</a>
                <a href="/about" class="nav-link">About</a>
