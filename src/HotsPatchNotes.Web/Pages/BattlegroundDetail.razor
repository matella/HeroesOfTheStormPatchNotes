@page "/battleground/{ShortName}"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IBattlegroundService BattlegroundService

<PageTitle>@(battleground?.Name ?? "Battleground") - Nexus Codex</PageTitle>

@if (loading)
{
    <div class="loading">
        <div class="spinner"></div>
        <p>Chargement…</p>
    </div>
}
else if (battleground == null)
{
    <div class="not-found">
        <h2>Battleground introuvable</h2>
        <a href="/battlegrounds" class="back-link">← Retour aux battlegrounds</a>
    </div>
}
else
{
    <div class="battleground-detail">
        <a href="/battlegrounds" class="back-link">← Battlegrounds</a>

        <div class="bg-banner" style="@BannerStyle">
            <div class="bg-banner-id">
                <h1>@battleground.Name</h1>
                <p class="bg-realm">@RealmLine</p>
            </div>
            <div class="bg-banner-badges">
                @if (battleground.IsInRotation)
                {
                    <span class="bdg b-buff">EN ROTATION</span>
                }
                else
                {
                    <span class="bdg b-nerf">HORS ROTATION</span>
                }
                @if (Lanes is not null)
                {
                    <span class="bdg b-bugfix">@Lanes VOIES</span>
                }
            </div>
        </div>

        <div class="bg-columns">
            <div class="bg-info">
                @if (!string.IsNullOrEmpty(battleground.Description)
                     && battleground.Description != battleground.Objective)
                {
                    <p class="bg-desc">@battleground.Description</p>
                }
                @if (!string.IsNullOrEmpty(battleground.Objective))
                {
                    <p class="kick">Objectif</p>
                    <div class="bg-text">@Render(battleground.Objective)</div>
                    @if (!string.IsNullOrEmpty(battleground.ObjectiveTiming))
                    {
                        <p class="bg-timing">@battleground.ObjectiveTiming</p>
                    }
                }
                @if (!string.IsNullOrEmpty(battleground.MercCamps))
                {
                    <p class="kick">Mercenaires &amp; boss</p>
                    <div class="bg-text">@Render(battleground.MercCamps)</div>
                }
                @if (!string.IsNullOrEmpty(battleground.BossInfo))
                {
                    <div class="bg-text">@Render(battleground.BossInfo)</div>
                }
                @if (!string.IsNullOrEmpty(battleground.Tips))
                {
                    <p class="kick">Conseil</p>
                    <div class="bg-text bg-tips">@Render(battleground.Tips)</div>
                }
            </div>

            <div class="bg-changes">
                <p class="kick">Changements de la carte</p>
                @if (!battleground.RecentPatches.Any())
                {
                    <p class="no-changes">Aucun changement archivé pour cette carte.</p>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var patch in battleground.RecentPatches)
                        {
                            <div class="timeline-item">
                                @if (!string.IsNullOrEmpty(patch.Classification))
                                {
                                    <span class="bdg b-@patch.Classification.ToLower()">@patch.Classification</span>
                                }
                                <a class="timeline-meta" href="/patch/@patch.InternalId">
                                    @(patch.LiveDate?.ToString("yyyy-MM-dd") ?? patch.PatchName)
                                    @if (patch.LiveDate.HasValue && !string.IsNullOrEmpty(patch.PatchName))
                                    {
                                        <span> · @patch.PatchName</span>
                                    }
                                </a>
                                @if (!string.IsNullOrEmpty(patch.ShortSummary))
                                {
                                    <p class="timeline-summary">@patch.ShortSummary</p>
                                }
                                <details class="timeline-details">
                                    <summary>détail</summary>
                                    <div class="timeline-content">@((MarkupString)DiffColorizer.Colorize(patch.Content))</div>
                                </details>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string ShortName { get; set; } = "";

    private BattlegroundDetailDto? battleground;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            battleground = await BattlegroundService.GetBattlegroundAsync(ShortName);
        }
        finally
        {
            loading = false;
        }
    }

    private string BannerStyle =>
        string.IsNullOrEmpty(battleground?.ImageUrl)
            ? ""
            : $"background-image: linear-gradient(rgba(14,16,22,.55), rgba(14,16,22,.88)), url('{battleground.ImageUrl}');";

    private string RealmLine
    {
        get
        {
            var parts = new List<string>();
            if (!string.IsNullOrEmpty(battleground?.Universe))
                parts.Add(battleground.Universe.ToUpper());
            if (battleground?.ReleaseDate is { } d)
                parts.Add(d.Year.ToString());
            return string.Join(" · ", parts);
        }
    }

    private string? Lanes =>
        battleground?.MapType is { } t && t.EndsWith("-Lane") ? t.Replace("-Lane", "") : null;

    /// <summary>Wiki fields hold sanitized HTML; older rows hold plain text — render either.</summary>
    private MarkupString Render(string content) =>
        (MarkupString)(content.Contains('<') ? content : PlainToHtml(content));

    private static string PlainToHtml(string content)
    {
        var lines = content.Split('\n');
        var sb = new System.Text.StringBuilder();
        var inList = false;
        foreach (var raw in lines)
        {
            var line = raw.Trim();
            if (line.Length == 0)
            {
                if (inList) { sb.Append("</ul>"); inList = false; }
                continue;
            }
            if (line.StartsWith("- ") || line.StartsWith("* "))
            {
                if (!inList) { sb.Append("<ul>"); inList = true; }
                sb.Append($"<li>{System.Net.WebUtility.HtmlEncode(line[2..])}</li>");
            }
            else
            {
                if (inList) { sb.Append("</ul>"); inList = false; }
                sb.Append($"<p>{System.Net.WebUtility.HtmlEncode(line)}</p>");
            }
        }
        if (inList) sb.Append("</ul>");
        return sb.ToString();
    }
}
