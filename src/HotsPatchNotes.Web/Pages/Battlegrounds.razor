@page "/battlegrounds"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IBattlegroundService BattlegroundService

<PageTitle>Battlegrounds - Nexus Codex</PageTitle>

<div class="battlegrounds-page">
    <div class="filter-bar">
        <button class="pill-filter @(showRotation == null ? "active" : "")"
                @onclick="() => FilterByRotation(null)">Toutes</button>
        <button class="pill-filter @(showRotation == true ? "active" : "")"
                @onclick="() => FilterByRotation(true)">En rotation</button>
        <button class="pill-filter @(showRotation == false ? "active" : "")"
                @onclick="() => FilterByRotation(false)">Hors rotation</button>
        <span class="map-total">@filteredBattlegrounds.Count() cartes</span>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Chargement des battlegrounds…</p>
        </div>
    }
    else if (!battlegrounds.Any())
    {
        <div class="empty-state"><p>Aucun battleground.</p></div>
    }
    else
    {
        <div class="battlegrounds-grid">
            @foreach (var map in filteredBattlegrounds)
            {
                <a href="/battleground/@map.ShortName" class="battleground-card @(!map.IsInRotation ? "out-of-rotation" : "")">
                    <div class="map-image">
                        @if (!string.IsNullOrEmpty(map.ImageUrl))
                        {
                            <img src="@map.ImageUrl" alt="@map.Name" loading="lazy" />
                        }
                        else
                        {
                            <div class="placeholder-image"></div>
                        }
                    </div>
                    <p class="map-name">@map.Name</p>
                    <p class="map-sub">@MetaLine(map)</p>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<BattlegroundSummaryDto> battlegrounds = new();
    private bool loading = true;
    private bool? showRotation = null;

    private IEnumerable<BattlegroundSummaryDto> filteredBattlegrounds =>
        showRotation.HasValue
            ? battlegrounds.Where(b => b.IsInRotation == showRotation.Value)
            : battlegrounds;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            battlegrounds = await BattlegroundService.GetBattlegroundsAsync();
        }
        finally
        {
            loading = false;
        }
    }

    private void FilterByRotation(bool? inRotation)
    {
        showRotation = inRotation;
    }

    private static string MetaLine(BattlegroundSummaryDto map)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(map.MapType) && map.MapType.EndsWith("-Lane"))
            parts.Add(map.MapType.Replace("-Lane", " voies"));
        else if (!string.IsNullOrEmpty(map.MapType))
            parts.Add(map.MapType);
        if (map.ChangeCount > 0)
            parts.Add(map.ChangeCount > 1 ? $"{map.ChangeCount} changements" : "1 changement");
        if (!map.IsInRotation)
            parts.Add("hors rotation");
        return string.Join(" · ", parts);
    }
}
