@page "/battlegrounds"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IBattlegroundService BattlegroundService

<PageTitle>Battlegrounds - HotS Patch Notes</PageTitle>

<div class="battlegrounds-page">
    <div class="page-header">
        <h1>Battlegrounds</h1>
        <p class="subtitle">Explore the maps of the Nexus</p>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading battlegrounds...</p>
        </div>
    }
    else if (!battlegrounds.Any())
    {
        <div class="empty-state">
            <p>No battlegrounds found.</p>
            <p class="hint">Battleground data will be added soon.</p>
        </div>
    }
    else
    {
        <div class="filters">
            <button class="filter-btn @(showRotation == null ? "active" : "")" 
                    @onclick="() => FilterByRotation(null)">All Maps</button>
            <button class="filter-btn @(showRotation == true ? "active" : "")" 
                    @onclick="() => FilterByRotation(true)">In Rotation</button>
            <button class="filter-btn @(showRotation == false ? "active" : "")" 
                    @onclick="() => FilterByRotation(false)">Out of Rotation</button>
        </div>

        <div class="battlegrounds-grid">
            @foreach (var map in filteredBattlegrounds)
            {
                <a href="/battleground/@map.ShortName" class="battleground-card @(!map.IsInRotation ? "out-of-rotation" : "")">
                    <div class="map-image">
                        @if (!string.IsNullOrEmpty(map.ImageUrl))
                        {
                            <img src="@map.ImageUrl" alt="@map.Name" />
                        }
                        else
                        {
                            <div class="placeholder-image">🗺️</div>
                        }
                        @if (!map.IsInRotation)
                        {
                            <span class="rotation-badge">Out of Rotation</span>
                        }
                    </div>
                    <div class="map-info">
                        <h3>@map.Name</h3>
                        @if (!string.IsNullOrEmpty(map.MapType))
                        {
                            <span class="map-type">@map.MapType</span>
                        }
                        @if (!string.IsNullOrEmpty(map.Universe))
                        {
                            <span class="universe universe-@(map.Universe?.ToLower())">@map.Universe</span>
                        }
                        @if (!string.IsNullOrEmpty(map.Description))
                        {
                            <p class="description">@TruncateDescription(map.Description)</p>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<BattlegroundSummaryDto> battlegrounds = new();
    private bool loading = true;
    private bool? showRotation = null;

    private IEnumerable<BattlegroundSummaryDto> filteredBattlegrounds => 
        showRotation.HasValue 
            ? battlegrounds.Where(b => b.IsInRotation == showRotation.Value)
            : battlegrounds;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            battlegrounds = await BattlegroundService.GetBattlegroundsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading battlegrounds: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void FilterByRotation(bool? inRotation)
    {
        showRotation = inRotation;
    }

    private string TruncateDescription(string description)
    {
        if (description.Length <= 120)
            return description;
        return description.Substring(0, 117) + "...";
    }
}
