@page "/hero/{ShortName}"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IHeroService HeroService
@inject NavigationManager Navigation

<PageTitle>@(hero?.Name ?? "Hero") - HotS Patch Notes</PageTitle>

@if (loading)
{
    <div class="loading">
        <div class="spinner"></div>
        <p>Loading hero data...</p>
    </div>
}
else if (hero == null)
{
    <div class="not-found">
        <h2>Hero Not Found</h2>
        <p>The hero "@ShortName" could not be found.</p>
        <a href="/" class="btn-back">← Back to Heroes</a>
    </div>
}
else
{
    <div class="hero-detail">
        <a href="/" class="back-link">← Back to Heroes</a>

        <div class="hero-header">
            <div class="hero-portrait">
                <img src="https://raw.githubusercontent.com/heroespatchnotes/heroes-talents/master/images/heroes/@(hero.Icon ?? hero.ShortName + ".png")"
                     alt="@hero.Name" />
            </div>
            <div class="hero-title">
                <h1>@hero.Name</h1>
                @if (!string.IsNullOrEmpty(hero.Title))
                {
                    <p class="hero-subtitle">@hero.Title</p>
                }
                <div class="hero-meta">
                    <span class="role role-@(hero.ExpandedRole?.ToLower().Replace(" ", "-"))">@hero.ExpandedRole</span>
                    <span class="type">@hero.Type</span>
                    @if (!string.IsNullOrEmpty(hero.Universe))
                    {
                        <span class="universe">@hero.Universe</span>
                    }
                    @if (!string.IsNullOrEmpty(hero.Difficulty))
                    {
                        <span class="difficulty">@hero.Difficulty</span>
                    }
                    @if (hero.ReleaseDate.HasValue)
                    {
                        <span class="release">Released @hero.ReleaseDate.Value.ToString("MMM d, yyyy")</span>
                    }
                </div>
                @if (hero.Tags.Any())
                {
                    <div class="hero-tags">
                        @foreach (var tag in hero.Tags)
                        {
                            <span class="tag">@FormatTag(tag)</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (HasBaseStats())
        {
            <div class="base-stats">
                <h3>Base Stats</h3>
                <div class="stats-grid">
                    @if (hero.BaseHealth.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Health</span>
                            <span class="stat-value">@hero.BaseHealth</span>
                        </div>
                    }
                    @if (hero.HealthRegen.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Health Regen</span>
                            <span class="stat-value">@hero.HealthRegen.Value.ToString("F2")/s</span>
                        </div>
                    }
                    @if (hero.BaseMana.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Mana</span>
                            <span class="stat-value">@hero.BaseMana</span>
                        </div>
                    }
                    @if (hero.ManaRegen.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Mana Regen</span>
                            <span class="stat-value">@hero.ManaRegen.Value.ToString("F2")/s</span>
                        </div>
                    }
                    @if (hero.BaseAttackDamage.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Attack Damage</span>
                            <span class="stat-value">@hero.BaseAttackDamage.Value.ToString("F0")</span>
                        </div>
                    }
                    @if (hero.AttackSpeed.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Attack Speed</span>
                            <span class="stat-value">@hero.AttackSpeed.Value.ToString("F2")</span>
                        </div>
                    }
                    @if (hero.AttackRange.HasValue)
                    {
                        <div class="stat-item">
                            <span class="stat-label">Attack Range</span>
                            <span class="stat-value">@hero.AttackRange.Value.ToString("F1")</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="section">
            <div class="section-header">
                <h2>Abilities</h2>
                <button class="toggle-btn" @onclick="() => showAbilities = !showAbilities">
                    @(showAbilities ? "▾ Collapse" : "▸ Expand")
                </button>
            </div>
            @if (showAbilities)
            {
                @foreach (var (formName, abilities) in hero.Abilities)
                {
                    @if (hero.Abilities.Count > 1)
                    {
                        <h3 class="form-name">@FormatFormName(formName)</h3>
                    }
                    <div class="abilities-grid">
                        @foreach (var ability in abilities.OrderBy(a => GetAbilityOrder(a)))
                        {
                            <div class="ability-card">
                                <div class="ability-header">
                                    <div class="ability-icon">
                                        <img src="https://raw.githubusercontent.com/heroespatchnotes/heroes-talents/master/images/talents/@ability.Icon"
                                             alt="@ability.Name"
                                             onerror="this.style.display='none'" />
                                    </div>
                                    <div class="ability-info">
                                        <h4>
                                            @if (!string.IsNullOrEmpty(ability.Hotkey))
                                            {
                                                <span class="hotkey">@ability.Hotkey</span>
                                            }
                                            @ability.Name
                                        </h4>
                                        <div class="ability-meta">
                                            @if (ability.Cooldown.HasValue)
                                            {
                                                <span>⏱ @ability.Cooldown s</span>
                                            }
                                            @if (!string.IsNullOrEmpty(ability.ManaCost))
                                            {
                                                <span>💧 @ability.ManaCost</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <p class="ability-desc">@((MarkupString)FormatDescription(ability.Description ?? ""))</p>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="collapsed-list">
                    @foreach (var (formName, abilities) in hero.Abilities)
                    {
                        @foreach (var ability in abilities.OrderBy(a => GetAbilityOrder(a)))
                        {
                            <div class="collapsed-item">
                                <div class="ability-icon small">
                                    <img src="https://raw.githubusercontent.com/heroespatchnotes/heroes-talents/master/images/talents/@ability.Icon"
                                         alt="@ability.Name"
                                         onerror="this.style.display='none'" />
                                </div>
                                @if (!string.IsNullOrEmpty(ability.Hotkey))
                                {
                                    <span class="hotkey small">@ability.Hotkey</span>
                                }
                                <span class="collapsed-name">@ability.Name</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <div class="section">
            <div class="talents-header">
                <div class="talents-title-row">
                    <h2>Talents</h2>
                    <button class="toggle-btn" @onclick="() => showTalents = !showTalents">
                        @(showTalents ? "▾ Collapse" : "▸ Expand")
                    </button>
                </div>
                @if (HasBuildSelected())
                {
                    <div class="build-code-display sticky">
                        <span class="build-code">@GetBuildCode()</span>
                        <button class="copy-btn" @onclick="CopyBuildCode" title="Copy build code">
                            @(copied ? "✓ Copied!" : "📋 Copy")
                        </button>
                        <button class="clear-btn" @onclick="ClearBuild" title="Clear selection">
                            ✕ Clear
                        </button>
                    </div>
                }
            </div>
            @if (showTalents)
            {
                <div class="talent-tree">
                    @foreach (var (level, talents) in hero.Talents.OrderBy(t => t.Key))
                    {
                        <div class="talent-tier">
                            <div class="tier-level">
                                <span class="level-number">@level</span>
                            </div>
                            <div class="tier-talents">
                                @{
                                    var sortedTalents = talents.OrderBy(t => t.Sort).ToList();
                                }
                                @foreach (var talent in sortedTalents)
                                {
                                    var talentIndex = sortedTalents.IndexOf(talent) + 1;
                                    var isSelected = selectedTalents.ContainsKey(level) && selectedTalents[level] == talentIndex;
                                    <div class="talent-card @(isSelected ? "selected" : "")"
                                         @onclick="() => SelectTalent(level, talentIndex)">
                                        @if (isSelected)
                                        {
                                            <span class="selected-indicator">✓</span>
                                        }
                                        <div class="talent-icon">
                                            <img src="https://raw.githubusercontent.com/heroespatchnotes/heroes-talents/master/images/talents/@talent.Icon"
                                                 alt="@talent.Name"
                                                 onerror="this.style.display='none'" />
                                        </div>
                                        <div class="talent-info">
                                            <h4>@talent.Name</h4>
                                            @if (!string.IsNullOrEmpty(talent.Type))
                                            {
                                                <span class="talent-type">@talent.Type</span>
                                            }
                                            <p class="talent-desc">@((MarkupString)FormatDescription(talent.Description ?? ""))</p>
                                            @if (talent.Cooldown.HasValue)
                                            {
                                                <span class="talent-cooldown">⏱ @talent.Cooldown s cooldown</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="talent-tree collapsed">
                    @foreach (var (level, talents) in hero.Talents.OrderBy(t => t.Key))
                    {
                        <div class="talent-tier">
                            <div class="tier-level">
                                <span class="level-number">@level</span>
                            </div>
                            <div class="tier-talents collapsed-talents">
                                @foreach (var talent in talents.OrderBy(t => t.Sort))
                                {
                                    <div class="collapsed-item" @onclick="() => showTalents = true">
                                        <div class="talent-icon small">
                                            <img src="https://raw.githubusercontent.com/heroespatchnotes/heroes-talents/master/images/talents/@talent.Icon"
                                                 alt="@talent.Name"
                                                 onerror="this.style.display='none'" />
                                        </div>
                                        <span class="collapsed-name">@talent.Name</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="section patch-history-section">
            <div class="section-header">
                <h2>Patch History</h2>
                @if (heroPatches.Any())
                {
                    <span class="patch-count">@GetFilteredPatchCount() patches</span>
                }
            </div>

            @if (loadingPatches)
            {
                <p class="loading-text">Loading patch history...</p>
            }
            else if (!heroPatches.Any())
            {
                <p class="no-patches">No patch history found for this hero.</p>
            }
            else
            {
                <div class="patch-filters">
                    <button class="filter-btn @(selectedPatchType == null ? "active" : "")"
                            @onclick='() => selectedPatchType = null'>
                        All
                    </button>
                    @foreach (var type in GetAvailablePatchTypes())
                    {
                        <button class="filter-btn @(selectedPatchType == type ? "active" : "")"
                                @onclick='() => selectedPatchType = type'>
                            @type
                        </button>
                    }
                </div>

                <div class="patch-history-list">
                    @foreach (var patchGroup in GetFilteredPatches())
                    {
                        var firstSection = patchGroup.First();
                        var isExpanded = expandedPatches.Contains(firstSection.PatchId);
                        <div class="patch-item">
                            <div class="patch-item-header" @onclick="() => TogglePatch(firstSection.PatchId)">
                                <div class="patch-item-left">
                                    <a href="/patch/@firstSection.InternalId" class="patch-name" @onclick:stopPropagation="true">
                                        @firstSection.PatchName
                                    </a>
                                    @if (firstSection.LiveDate.HasValue)
                                    {
                                        <span class="patch-date">@firstSection.LiveDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                </div>
                                <div class="patch-item-right">
                                    @if (!string.IsNullOrEmpty(firstSection.PatchType))
                                    {
                                        <span class="patch-type-badge type-@GetPatchTypeCssClass(firstSection.PatchType)">
                                            @firstSection.PatchType
                                        </span>
                                    }
                                    <span class="expand-icon">@(isExpanded ? "▾" : "▸")</span>
                                </div>
                            </div>
                            @if (isExpanded)
                            {
                                <div class="patch-item-content">
                                    @foreach (var section in patchGroup.OrderBy(s => s.Order))
                                    {
                                        <div class="patch-section-content">
                                            @((MarkupString)StripReturnLinks(section.Content))
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string ShortName { get; set; } = "";

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    private HeroDetailDto? hero;
    private List<HeroPatchDto> heroPatches = [];
    private bool loading = true;
    private bool loadingPatches = true;
    private bool showAbilities = true;
    private bool showTalents = true;
    private Dictionary<int, int> selectedTalents = new();
    private HashSet<int> expandedPatches = [];
    private bool copied = false;
    private string? selectedPatchType = null;
    private bool tooltipsInitialized = false;
    private static readonly int[] TalentTiers = { 1, 4, 7, 10, 13, 16, 20 };

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        loadingPatches = true;
        try
        {
            hero = await HeroService.GetHeroAsync(ShortName);
        }
        finally
        {
            loading = false;
        }

        if (hero is not null)
        {
            try
            {
                heroPatches = await HeroService.GetHeroPatchesAsync(ShortName);
            }
            finally
            {
                loadingPatches = false;
            }
        }
        else
        {
            loadingPatches = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialize tooltips after patches are expanded and rendered
        if (!tooltipsInitialized && hero is not null && heroPatches.Any() && expandedPatches.Any())
        {
            await InitializeTooltipsAsync();
        }
    }

    private async Task TogglePatch(int patchId)
    {
        var wasExpanded = expandedPatches.Contains(patchId);

        if (!expandedPatches.Remove(patchId))
        {
            expandedPatches.Add(patchId);
        }

        // Initialize tooltips after first patch expansion
        if (!wasExpanded && !tooltipsInitialized && hero is not null)
        {
            // Force re-render and wait for DOM update
            StateHasChanged();
            await Task.Delay(50);
            await InitializeTooltipsAsync();
        }
    }

    private async Task InitializeTooltipsAsync()
    {
        if (tooltipsInitialized || hero is null) return;

        // Flatten abilities from all forms
        var abilities = hero.Abilities
            .SelectMany(kvp => kvp.Value)
            .Select(a => new
            {
                name = a.Name,
                hotkey = a.Hotkey,
                description = a.Description,
                cooldown = a.Cooldown,
                manaCost = a.ManaCost,
                icon = a.Icon
            })
            .ToList();

        // Flatten talents from all levels
        var talents = hero.Talents
            .SelectMany(kvp => kvp.Value)
            .Select(t => new
            {
                name = t.Name,
                description = t.Description,
                icon = t.Icon
            })
            .ToList();

        await JSRuntime.InvokeVoidAsync("patchTooltips.initialize", abilities, talents);
        tooltipsInitialized = true;
    }

    private bool HasBaseStats()
    {
        return hero is not null && (hero.BaseHealth.HasValue || hero.BaseAttackDamage.HasValue ||
               hero.AttackSpeed.HasValue || hero.AttackRange.HasValue ||
               hero.HealthRegen.HasValue || hero.BaseMana.HasValue || hero.ManaRegen.HasValue);
    }

    private void SelectTalent(int level, int choice)
    {
        if (selectedTalents.ContainsKey(level) && selectedTalents[level] == choice)
        {
            selectedTalents.Remove(level);
        }
        else
        {
            selectedTalents[level] = choice;
        }
        copied = false;
    }

    private bool HasBuildSelected() => selectedTalents.Any();

    private string GetBuildCode()
    {
        if (!selectedTalents.Any()) return "";

        var code = new char[7];
        for (int i = 0; i < TalentTiers.Length; i++)
        {
            code[i] = selectedTalents.TryGetValue(TalentTiers[i], out var choice)
                ? (char)('0' + choice)
                : '0';
        }
        return $"[T{new string(code)},{hero?.ShortName ?? ""}]";
    }

    private async Task CopyBuildCode()
    {
        var code = GetBuildCode();
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", code);
        copied = true;
        await Task.Delay(2000);
        copied = false;
    }

    private void ClearBuild()
    {
        selectedTalents.Clear();
        copied = false;
    }

    private string FormatTag(string tag)
    {
        return string.Concat(tag.Select((c, i) =>
            i > 0 && char.IsUpper(c) ? " " + c : c.ToString()));
    }

    private string FormatFormName(string formName)
    {
        if (formName == hero?.Name) return "Base Abilities";
        return formName + " Abilities";
    }

    private int GetAbilityOrder(AbilityDto ability)
    {
        return ability.Type?.ToLower() switch
        {
            "trait" => 0,
            "basic" => ability.Hotkey switch
            {
                "Q" => 1,
                "W" => 2,
                "E" => 3,
                _ => 4
            },
            "heroic" => 5,
            "mount" => 6,
            _ => 7
        };
    }

    private string FormatDescription(string description)
    {
        return description
            .Replace("<n/>", "<br/>")
            .Replace("<s val=\"StandardTooltipHeader\">", "<strong>")
            .Replace("</s>", "</strong>");
    }

    private static string StripReturnLinks(string content)
    {
        return System.Text.RegularExpressions.Regex.Replace(
            content,
            @"<a[^>]*href=""#return""[^>]*>.*?</a>",
            string.Empty,
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    private static string GetPatchTypeCssClass(string patchType)
    {
        return patchType.ToLowerInvariant() switch
        {
            "balance update" => "balance",
            "major patch" => "major",
            "hotfix patch" => "hotfix",
            "ptr" => "ptr",
            _ => "default"
        };
    }

    private IEnumerable<string> GetAvailablePatchTypes()
    {
        return heroPatches
            .Where(p => !string.IsNullOrEmpty(p.PatchType))
            .Select(p => p.PatchType!)
            .Distinct()
            .OrderBy(t => t);
    }

    private IEnumerable<IGrouping<int, HeroPatchDto>> GetFilteredPatches()
    {
        var filtered = selectedPatchType == null
            ? heroPatches
            : heroPatches.Where(p => p.PatchType == selectedPatchType);

        return filtered
            .GroupBy(p => p.PatchId)
            .OrderByDescending(g => g.First().LiveDate);
    }

    private int GetFilteredPatchCount()
    {
        return GetFilteredPatches().Count();
    }
}
