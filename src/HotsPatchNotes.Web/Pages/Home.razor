@page "/"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IHeroService HeroService

<PageTitle>Heroes - HotS Patch Notes</PageTitle>

<div class="heroes-page">
    <div class="page-header">
        <h1>Heroes of the Storm</h1>
        <p class="subtitle">Browse all @heroes.Count heroes and their abilities, talents, and patch history</p>
    </div>

    <div class="filters">
        <div class="search-box">
            <input type="text" 
                   placeholder="Search heroes..." 
                   @bind="searchTerm" 
                   @bind:event="oninput"
                   @onkeyup="FilterHeroes" />
        </div>
        
        <div class="filter-group">
            <label>Role:</label>
            <select @bind="selectedRole" @bind:after="FilterHeroes">
                <option value="">All Roles</option>
                @foreach (var role in roles)
                {
                    <option value="@role">@role</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label>Type:</label>
            <select @bind="selectedType" @bind:after="FilterHeroes">
                <option value="">All Types</option>
                <option value="Melee">Melee</option>
                <option value="Ranged">Ranged</option>
            </select>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading heroes...</p>
        </div>
    }
    else if (filteredHeroes.Count == 0)
    {
        <div class="no-results">
            <p>No heroes found matching your criteria.</p>
        </div>
    }
    else
    {
        <div class="heroes-grid">
            @foreach (var hero in filteredHeroes)
            {
                <a href="/hero/@hero.ShortName" class="hero-card">
                    <div class="hero-icon">
                        <img src="https://raw.githubusercontent.com/heroespatchnotes/heroes-talents/master/images/heroes/@(hero.Icon ?? hero.ShortName + ".png")" 
                             alt="@hero.Name"
                             onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect fill=%22%23333%22 width=%22100%22 height=%22100%22/><text x=%2250%22 y=%2250%22 fill=%22%23fff%22 text-anchor=%22middle%22 dominant-baseline=%22central%22 font-size=%2240%22>?</text></svg>'" />
                    </div>
                    <div class="hero-info">
                        <h3 class="hero-name">@hero.Name</h3>
                        <span class="hero-role role-@(hero.ExpandedRole?.ToLower().Replace(" ", "-"))">@hero.ExpandedRole</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<HeroSummaryDto> heroes = new();
    private List<HeroSummaryDto> filteredHeroes = new();
    private List<string> roles = new();
    private bool loading = true;
    
    private string searchTerm = "";
    private string selectedRole = "";
    private string selectedType = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            heroes = await HeroService.GetHeroesAsync();
            roles = await HeroService.GetRolesAsync();
            filteredHeroes = heroes;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading heroes: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void FilterHeroes()
    {
        filteredHeroes = heroes.Where(h =>
        {
            var matchesSearch = string.IsNullOrWhiteSpace(searchTerm) ||
                h.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                h.ShortName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);
            
            var matchesRole = string.IsNullOrWhiteSpace(selectedRole) ||
                h.ExpandedRole == selectedRole || h.Role == selectedRole;
            
            var matchesType = string.IsNullOrWhiteSpace(selectedType) ||
                h.Type == selectedType;

            return matchesSearch && matchesRole && matchesType;
        }).ToList();
    }
}
