@page "/patch/{InternalId}"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IPatchService PatchService
@inject NavigationManager Navigation

<PageTitle>@(patch?.PatchName ?? "Patch Details") - HotS Patch Notes</PageTitle>

<div class="patch-detail-page">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading patch notes...</p>
        </div>
    }
    else if (patch == null)
    {
        <div class="not-found">
            <h2>Patch Not Found</h2>
            <p>The patch you're looking for doesn't exist.</p>
            <a href="/patches" class="back-link">← Back to Patches</a>
        </div>
    }
    else
    {
        <div class="patch-header">
            <a href="/patches" class="back-link">← Back to Patches</a>
            
            <h1 id="return">@patch.PatchName</h1>
            
            <div class="patch-meta">
                @if (!string.IsNullOrEmpty(patch.PatchType))
                {
                    <span class="patch-type @GetPatchTypeClass(patch.PatchType)">@patch.PatchType</span>
                }
                @if (patch.LiveDate.HasValue)
                {
                    <span class="patch-date">@patch.LiveDate.Value.ToString("MMMM d, yyyy")</span>
                }
                @if (!string.IsNullOrEmpty(patch.OfficialLink))
                {
                    <a href="@patch.OfficialLink" target="_blank" rel="noopener" class="official-link">
                        Official Patch Notes ↗
                    </a>
                }
            </div>
        </div>

        <div class="patch-layout">
            @if (patch.TableOfContents.Count > 0)
            {
                <aside class="toc-sidebar">
                    <h3>Navigation</h3>
                    <nav class="toc">
                        @foreach (var item in patch.TableOfContents.Where(t => t.HeadingLevel <= 2))
                        {
                            <a href="#@item.Anchor" class="toc-item level-@item.HeadingLevel @GetTocTypeClass(item.SectionType)">
                                @item.Title
                            </a>
                        }
                    </nav>
                </aside>
            }

            <div class="patch-content">
                @if (patch.Sections.Count > 0)
                {
                    @foreach (var sec in patch.Sections)
                    {
                        var anchor = GenerateAnchor(sec.EntityName, sec.Order);
                        <div class="patch-section level-@sec.HeadingLevel type-@sec.SectionType.ToLower()">
                            @switch (sec.HeadingLevel)
                            {
                                case 1:
                                    <h1 id="@anchor">@sec.EntityName</h1>
                                    break;
                                case 2:
                                    <h2 id="@anchor">@sec.EntityName</h2>
                                    break;
                                case 3:
                                    <h3 id="@anchor">@sec.EntityName</h3>
                                    break;
                                case 4:
                                    <h4 id="@anchor">@sec.EntityName</h4>
                                    break;
                                default:
                                    <h5 id="@anchor">@sec.EntityName</h5>
                                    break;
                            }
                            @if (!string.IsNullOrWhiteSpace(sec.Content))
                            {
                                <div class="section-content">
                                    @((MarkupString)FormatMarkdown(sec.Content))
                                </div>
                            }
                            @if (sec.HeadingLevel >= 2)
                            {
                                <a href="#return" class="return-link">↑ Return to Top</a>
                            }
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(patch.Content))
                {
                    <div class="content-body">
                        @((MarkupString)FormatMarkdown(patch.Content))
                    </div>
                }
                else
                {
                    <div class="no-content">
                        <p>Full patch notes content not available.</p>
                        @if (!string.IsNullOrEmpty(patch.OfficialLink))
                        {
                            <p>
                                <a href="@patch.OfficialLink" target="_blank" rel="noopener">
                                    View official patch notes on Blizzard's website →
                                </a>
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string InternalId { get; set; } = string.Empty;

    private ReconstructedPatchDto? patch;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatch();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPatch();
    }

    private async Task LoadPatch()
    {
        isLoading = true;
        patch = await PatchService.GetPatchAsync(InternalId);
        isLoading = false;
    }

    private string GetPatchTypeClass(string patchType)
    {
        return patchType.ToLowerInvariant() switch
        {
            "balance update" => "type-balance",
            "major patch" => "type-major",
            "hotfix patch" => "type-hotfix",
            "ptr" => "type-ptr",
            _ => "type-default"
        };
    }

    private string GetTocTypeClass(string sectionType)
    {
        return sectionType.ToLowerInvariant() switch
        {
            "general" => "toc-general",
            "map" => "toc-map",
            "balance" => "toc-balance",
            "bugfix" => "toc-bugfix",
            "hero" => "toc-hero",
            _ => ""
        };
    }

    private static string GenerateAnchor(string title, int order)
    {
        var anchor = title.ToLowerInvariant();
        anchor = System.Text.RegularExpressions.Regex.Replace(anchor, @"[^a-z0-9\s-]", "");
        anchor = System.Text.RegularExpressions.Regex.Replace(anchor, @"\s+", "-");
        anchor = System.Text.RegularExpressions.Regex.Replace(anchor, @"-+", "-");
        anchor = anchor.Trim('-');
        return $"{anchor}-{order}";
    }

    private string FormatMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content))
            return string.Empty;

        var html = System.Web.HttpUtility.HtmlEncode(content);

        // Convert line breaks
        html = html.Replace("\r\n", "\n");

        // Convert markdown headers (process longer patterns first)
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^#### (.+)$", "<h4>$1</h4>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.+)$", "<h3>$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h2>$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^# (.+)$", "<h1>$1</h1>", System.Text.RegularExpressions.RegexOptions.Multiline);

        // Convert bold
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Convert italic
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");

        // Convert lists - wrap consecutive list items
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^- (.+)$", "<li>$1</li>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"((?:<li>.*?</li>\n?)+)", "<ul>$1</ul>");

        // Convert image links: [](url) or ![alt](url)
        html = System.Text.RegularExpressions.Regex.Replace(html, @"!\[([^\]]*)\]\(([^)]+)\)", "<img src=\"$2\" alt=\"$1\" class=\"patch-image\" />");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\[([^\]]*)\]\(([^)]+)\)", "<a href=\"$2\" target=\"_blank\">$1</a>");

        // Convert paragraphs (double newlines)
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\n\n+", "</p><p>");
        
        // Convert remaining single newlines to <br>
        html = html.Replace("\n", "<br/>");

        // Wrap in paragraph
        html = "<p>" + html + "</p>";

        // Clean up empty paragraphs
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<p>\s*</p>", "");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<p>(<h[1-4]>)", "$1");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(</h[1-4]>)</p>", "$1");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"<p>(<ul>)", "$1");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(</ul>)</p>", "$1");

        return html;
    }
}
