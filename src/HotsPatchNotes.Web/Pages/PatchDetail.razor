@using System.Globalization
@page "/patch/{InternalId}"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IPatchService PatchService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(patch?.PatchName ?? "Patch Details") - HotS Patch Notes</PageTitle>

<div class="patch-detail-page">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading patch notes...</p>
        </div>
    }
    else if (patch == null)
    {
        <div class="not-found">
            <h2>Patch Not Found</h2>
            <p>The patch you're looking for doesn't exist.</p>
            <a href="/patches" class="back-link">← Back to Patches</a>
        </div>
    }
    else
    {
        <div class="patch-header">
            <a href="/patches" class="back-link">← Back to Patches</a>
            
            <h1 id="return">@patch.PatchName</h1>
            
            <div class="patch-meta">
                @if (!string.IsNullOrEmpty(patch.PatchType))
                {
                    <span class="patch-type @GetPatchTypeClass(patch.PatchType)">
                        <span class="patch-type-icon">@GetPatchTypeIcon(patch.PatchType)</span>
                        @patch.PatchType
                    </span>
                }
                @if (patch.LiveDate.HasValue)
                {
                    <span class="patch-date">@patch.LiveDate.Value.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)</span>
                }
                @if (!string.IsNullOrEmpty(patch.OfficialLink))
                {
                    <a href="@patch.OfficialLink" target="_blank" rel="noopener" class="official-link">
                        Official Patch Notes ↗
                    </a>
                }
            </div>
        </div>

        <div class="patch-layout">
            @if (patch.TableOfContents.Count > 0)
            {
                <aside class="toc-sidebar">
                    <h3>Navigation</h3>
                    <nav class="toc">
                        @foreach (var item in patch.TableOfContents.Where(t => t.HeadingLevel <= 2))
                        {
                            <a href="#@item.Anchor" class="toc-item level-@item.HeadingLevel @GetTocTypeClass(item.SectionType)">
                                @item.Title
                            </a>
                        }
                    </nav>
                </aside>
            }

            <div class="patch-content">
                @if (patch.Sections.Count > 0)
                {
                    @foreach (var sec in patch.Sections)
                    {
                        <div class="patch-section level-@sec.HeadingLevel type-@sec.SectionType.ToLower()">
                            @switch (sec.HeadingLevel)
                            {
                                case 1:
                                    <h1 id="@sec.Anchor">@sec.EntityName</h1>
                                    break;
                                case 2:
                                    <h2 id="@sec.Anchor">@sec.EntityName</h2>
                                    break;
                                case 3:
                                    <h3 id="@sec.Anchor">@sec.EntityName</h3>
                                    break;
                                case 4:
                                    <h4 id="@sec.Anchor">@sec.EntityName</h4>
                                    break;
                                default:
                                    <h5 id="@sec.Anchor">@sec.EntityName</h5>
                                    break;
                            }
                            @if (!string.IsNullOrWhiteSpace(sec.Content))
                            {
                                <div class="section-content">
                                    @((MarkupString)sec.Content)
                                </div>
                            }
                            @if (sec.HeadingLevel >= 2)
                            {
                                <button @onclick="ScrollToTop" class="return-link">↑ Return to Top</button>
                            }
                        </div>
                    }
                }
                else if (!string.IsNullOrEmpty(patch.Content))
                {
                    <div class="content-body">
                        @((MarkupString)patch.Content)
                    </div>
                }
                else
                {
                    <div class="no-content">
                        <p>Full patch notes content not available.</p>
                        @if (!string.IsNullOrEmpty(patch.OfficialLink))
                        {
                            <p>
                                <a href="@patch.OfficialLink" target="_blank" rel="noopener">
                                    View official patch notes on Blizzard's website →
                                </a>
                            </p>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string InternalId { get; set; } = string.Empty;

    private ReconstructedPatchDto? patch;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatch();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPatch();
    }

    private async Task LoadPatch()
    {
        isLoading = true;
        patch = await PatchService.GetPatchAsync(InternalId);
        isLoading = false;
    }

    private string GetPatchTypeClass(string patchType)
    {
        return patchType.ToLowerInvariant() switch
        {
            "balance update" => "type-balance",
            "major patch" => "type-major",
            "hotfix patch" => "type-hotfix",
            "ptr" => "type-ptr",
            _ => "type-default"
        };
    }

    private string GetPatchTypeIcon(string patchType)
    {
        return patchType.ToLowerInvariant() switch
        {
            "balance update" => "⚖️",
            "major patch" => "🎮",
            "hotfix patch" => "🔧",
            "ptr" => "🧪",
            "patch notes" => "📋",
            _ => "📝"
        };
    }

    private string GetTocTypeClass(string sectionType)
    {
        return sectionType.ToLowerInvariant() switch
        {
            "general" => "toc-general",
            "map" => "toc-map",
            "balance" => "toc-balance",
            "bugfix" => "toc-bugfix",
            "hero" => "toc-hero",
            _ => ""
        };
    }

    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("scrollToAnchor", "return");
    }
}
