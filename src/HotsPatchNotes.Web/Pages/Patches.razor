@page "/patches"
@using HotsPatchNotes.Shared.DTOs
@using HotsPatchNotes.Web.Services
@inject IPatchService PatchService
@inject NavigationManager Navigation

<PageTitle>Patchs - Nexus Codex</PageTitle>

<div class="patches-page">
    <div class="filter-bar">
        @foreach (var bucket in FilterBuckets)
        {
            <button class="pill-filter @(selectedBucket == bucket ? "active" : "")"
                    @onclick="() => SetBucket(bucket)">@bucket</button>
        }
        <span class="patch-total">@visibleRows.Count patchs</span>
    </div>

    @if (loading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Chargement des patchs…</p>
        </div>
    }
    else if (visibleRows.Count == 0)
    {
        <div class="no-results"><p>Aucun patch.</p></div>
    }
    else
    {
        <div class="patches-list">
            @{ int? yearCursor = null; }
            @foreach (var row in visibleRows)
            {
                var rowYear = row.Date?.Year;
                if (rowYear != yearCursor)
                {
                    yearCursor = rowYear;
                    <div class="year-sep">@(rowYear?.ToString() ?? "Sans date")</div>
                }
                <a class="patch-row" href="/patch/@row.InternalId">
                    <span class="mono p-date">@FormatShortDate(row.Date)</span>
                    <span class="bdg @row.BadgeClass">@row.Badge</span>
                    <span class="p-name">@row.Name</span>
                    <span class="p-counts">@CountsLabel(row) ›</span>
                </a>
            }
        </div>
    }
</div>

@code {
    private static readonly string[] FilterBuckets = ["Tous", "Live", "PTR", "Hotfix", "Alpha/Beta"];
    private static readonly string[] FrMonths =
        ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."];

    private sealed record PatchRow(
        string InternalId, string Name, string Bucket, string Badge, string BadgeClass,
        DateTime? Date, int HeroCount, int MapCount);

    private List<PatchRow> allRows = [];
    private List<PatchRow> visibleRows = [];
    private bool loading = true;
    private string selectedBucket = "Tous";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var page = await PatchService.GetPatchesAsync(null, 1, 1000);
            allRows = Merge(page.Items);
            ApplyFilter();
        }
        finally
        {
            loading = false;
        }
    }

    private void SetBucket(string bucket)
    {
        selectedBucket = bucket;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        visibleRows = selectedBucket == "Tous"
            ? allRows
            : allRows.Where(r => r.Bucket == selectedBucket).ToList();
    }

    /// <summary>
    /// One row per patch: the archive (nexus) and Blizzard's feed both carry the same patch —
    /// merge same-day/same-bucket entries, linking to the section-rich one (the diff view)
    /// while keeping Blizzard's human title.
    /// </summary>
    private static List<PatchRow> Merge(List<PatchSummaryDto> items)
    {
        // The archive (nexus) and Blizzard's feed publish the same patch with up to one day of
        // date skew — cluster same-bucket entries ≤1 day apart when exactly one side is nexus.
        var sorted = items
            .Select(p => (Patch: p, Date: (p.LiveDate ?? p.PtrDate)?.Date, Bucket: BucketOf(p.PatchType)))
            .OrderByDescending(x => x.Date ?? DateTime.MinValue)
            .ToList();

        var rows = new List<PatchRow>();
        var used = new bool[sorted.Count];
        for (var i = 0; i < sorted.Count; i++)
        {
            if (used[i])
                continue;
            var members = new List<PatchSummaryDto> { sorted[i].Patch };
            for (var j = i + 1; j < sorted.Count; j++)
            {
                if (used[j] || sorted[j].Bucket != sorted[i].Bucket)
                    continue;
                if (sorted[i].Date is not { } a || sorted[j].Date is not { } b)
                    continue;
                if ((a - b).TotalDays > 1)
                    break;
                var jIsNexus = sorted[j].Patch.Source == "nexus";
                if (members.Any(m => (m.Source == "nexus") != jIsNexus))
                {
                    members.Add(sorted[j].Patch);
                    used[j] = true;
                }
            }

            var primary = members
                .OrderByDescending(p => p.HeroCount + p.MapCount)
                .ThenByDescending(p => p.HasContent)
                .First();
            var titled = members.FirstOrDefault(p => p.Source != "nexus" && !string.IsNullOrEmpty(p.PatchName))
                         ?? primary;
            rows.Add(new PatchRow(
                primary.InternalId,
                CleanName(titled.PatchName, sorted[i].Bucket),
                sorted[i].Bucket,
                BadgeOf(sorted[i].Bucket),
                BadgeClassOf(sorted[i].Bucket),
                members.Select(m => (m.LiveDate ?? m.PtrDate)?.Date).Min(),
                members.Max(p => p.HeroCount),
                members.Max(p => p.MapCount)));
        }
        return rows.OrderByDescending(r => r.Date ?? DateTime.MinValue).ToList();
    }

    private static string BucketOf(string? patchType) => patchType switch
    {
        "PTR" => "PTR",
        "Hotfix Patch" => "Hotfix",
        "Alpha Patch" or "Beta Patch" => "Alpha/Beta",
        _ => "Live",
    };

    private static string BadgeOf(string bucket) => bucket switch
    {
        "PTR" => "PTR",
        "Hotfix" => "HOTFIX",
        "Alpha/Beta" => "ALPHA·BETA",
        _ => "LIVE",
    };

    private static string BadgeClassOf(string bucket) => bucket switch
    {
        "PTR" => "b-ptr",
        "Hotfix" => "b-hotfix",
        "Alpha/Beta" => "b-bugfix",
        _ => "b-live",
    };

    private static string CleanName(string? name, string bucket)
    {
        if (string.IsNullOrWhiteSpace(name))
            return bucket + " Patch";
        var n = name.Trim();
        if (n.StartsWith("Heroes of the Storm ", StringComparison.OrdinalIgnoreCase))
            n = n["Heroes of the Storm ".Length..];
        var dash = n.LastIndexOf(" - ", StringComparison.Ordinal);
        if (dash > 0 && n[(dash + 3)..].Any(char.IsDigit))
            n = n[..dash];
        // archive auto-names ("2026-05-11 Live") — the date is already the row's first column
        var m = System.Text.RegularExpressions.Regex.Match(n, @"^\d{4}-\d{2}-\d{2} (\w+)$");
        if (m.Success)
        {
            n = m.Groups[1].Value switch
            {
                "Live" => "Live Patch",
                "Ptr" => "PTR Patch",
                "Hotfix" => "Hotfix",
                "Revert" => "Revert",
                "Alpha" => "Alpha Patch",
                "Beta" => "Beta Patch",
                var k => k + " Patch",
            };
        }
        return n;
    }

    private static string FormatShortDate(DateTime? date) =>
        date is null ? "—" : $"{date.Value.Day} {FrMonths[date.Value.Month - 1]}";

    private static string CountsLabel(PatchRow row)
    {
        var parts = new List<string>();
        if (row.HeroCount > 0) parts.Add($"{row.HeroCount} héros");
        if (row.MapCount > 0) parts.Add(row.MapCount > 1 ? $"{row.MapCount} cartes" : "1 carte");
        return parts.Count > 0 ? string.Join(" · ", parts) : "";
    }
}
